# --- WhatsApp Cloud API (Meta) ---
# WHATSAPP_API_VERSION=v25.0   # Meta retires old versions roughly 2 years after the next one ships; check Meta's changelog every few months
WHATSAPP_TOKEN=                # permanent system-user token
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=         # any random string; you type the same into Meta's webhook setup
WHATSAPP_APP_SECRET=           # Meta app secret, used to verify webhook signatures (required in production)

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5   # claude-haiku-5-5 is far cheaper if you want to trim cost

# --- Google Sheet (leads) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=   # paste the service-account JSON (or a path to it); share the sheet with its email

# --- Consultant alerts (email) ---
NOTIFY_TO=                     # comma-separated
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=                 # Gmail app password
NOTIFY_FROM=

# --- Misc ---
DB_PATH=data/sessions.sqlite3  # put on a Railway volume so conversations survive redeploys
HUMAN_DELAY_SECONDS=1.5        # pause between bot messages so it feels natural
DEV_MODE=0                     # 1 = skip webhook signature check (local testing only)
